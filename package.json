{
  "name": "tomcat-auto-deploy",
  "displayName": "Tomcat Auto Deploy",
  "description": "%extension.description%",
  "version": "0.10.0",
  "publisher": "ddakker",
  "author": {
    "name": "ddakker",
    "email": "ddakker@gmail.com"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/ddakker/vscode-tomcat-extension.git"
  },
  "engines": { "vscode": "^1.74.0" },
  "icon": "tomcat-logo.png",
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "extensionKind": ["workspace"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      { "command": "tomcatAutoDeploy.start",       "title": "%command.start%",           "icon": "$(play)"        },
      { "command": "tomcatAutoDeploy.stop",        "title": "%command.stop%",            "icon": "$(debug-stop)"  },
      { "command": "tomcatAutoDeploy.forceStop",   "title": "%command.forceStop%",       "icon": "$(close)"       },
      { "command": "tomcatAutoDeploy.restart",     "title": "%command.restart%",         "icon": "$(refresh)"     },
      { "command": "tomcatAutoDeploy.openBrowser", "title": "%command.openBrowser%",     "icon": "$(globe)"       },
      { "command": "tomcatAutoDeploy.showOutput",  "title": "%command.showOutput%",      "icon": "$(output)"      },
      { "command": "tomcatAutoDeploy.showLocalhostLog", "title": "%command.showLocalhostLog%", "icon": "$(file-text)" },
      { "command": "tomcatAutoDeploy.openServerXml", "title": "%command.openServerXml%",   "icon": "$(file-code)"   },
      { "command": "tomcatAutoDeploy.openContextXml", "title": "%command.openContextXml%", "icon": "$(file-code)"   },
      { "command": "tomcatAutoDeploy.configure",   "title": "%command.configure%",       "icon": "$(gear)"        },
      { "command": "tomcatAutoDeploy.deployAll",   "title": "%command.deployAll%",       "icon": "$(cloud-upload)" },
      { "command": "tomcatAutoDeploy.buildAndDeploy", "title": "%command.buildAndDeploy%", "icon": "$(tools)" },
      { "command": "tomcatAutoDeploy.syncStaticOnly", "title": "%command.syncStaticOnly%", "icon": "$(file-media)" },
      { "command": "tomcatAutoDeploy.startAll",    "title": "%command.startAll%",        "icon": "$(run-all)"     },
      { "command": "tomcatAutoDeploy.stopAll",     "title": "%command.stopAll%",         "icon": "$(stop-circle)" },
      { "command": "tomcatAutoDeploy.pickInstance", "title": "%command.pickInstance%",   "icon": "$(server)"      },
      { "command": "tomcatAutoDeploy.addInstance",  "title": "%command.addInstance%",     "icon": "$(add)"         },
      { "command": "tomcatAutoDeploy.removeInstance", "title": "%command.removeInstance%", "icon": "$(trash)"      },
      { "command": "tomcatAutoDeploy.deleteOrphanFolder", "title": "%command.deleteOrphanFolder%", "icon": "$(trash)" }
    ],
    "keybindings": [
      {
        "command": "tomcatAutoDeploy.deployAll",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tomcatExplorer",
          "title": "Tomcat",
          "icon": "tomcat-icon.svg"
        }
      ]
    },
    "views": {
      "tomcatExplorer": [
        {
          "id": "tomcatServerView",
          "name": "%view.server%",
          "icon": "tomcat-icon.svg",
          "contextualTitle": "%view.server.contextualTitle%"
        }
      ]
    },
    "menus": {
      "view/title": [
        { "command": "tomcatAutoDeploy.addInstance", "when": "view == tomcatServerView", "group": "navigation@0" },
        { "command": "tomcatAutoDeploy.configure", "when": "view == tomcatServerView", "group": "navigation@1" }
      ],
      "view/item/context": [
        { "command": "tomcatAutoDeploy.startAll", "when": "view == tomcatServerView && viewItem == controlHeader", "group": "inline@1" },
        { "command": "tomcatAutoDeploy.stopAll",  "when": "view == tomcatServerView && viewItem == controlHeader", "group": "inline@2" },

        { "command": "tomcatAutoDeploy.start",       "when": "view == tomcatServerView && viewItem == instanceStopped",  "group": "inline@1" },
        { "command": "tomcatAutoDeploy.stop",        "when": "view == tomcatServerView && viewItem == instanceStarting", "group": "inline@1" },
        { "command": "tomcatAutoDeploy.stop",        "when": "view == tomcatServerView && viewItem == instanceRunning",  "group": "inline@1" },
        { "command": "tomcatAutoDeploy.restart",     "when": "view == tomcatServerView && viewItem == instanceRunning",  "group": "inline@2" },
        { "command": "tomcatAutoDeploy.forceStop",   "when": "view == tomcatServerView && viewItem == instanceStarting", "group": "inline@2" },
        { "command": "tomcatAutoDeploy.forceStop",   "when": "view == tomcatServerView && viewItem == instanceRunning",  "group": "inline@3" },
        { "command": "tomcatAutoDeploy.openBrowser", "when": "view == tomcatServerView && viewItem == instanceRunning",  "group": "inline@4" },

        { "command": "tomcatAutoDeploy.start",       "when": "view == tomcatServerView && viewItem == instanceStopped",  "group": "1_run@1" },
        { "command": "tomcatAutoDeploy.stop",        "when": "view == tomcatServerView && viewItem == instanceStarting", "group": "1_run@1" },
        { "command": "tomcatAutoDeploy.stop",        "when": "view == tomcatServerView && viewItem == instanceRunning",  "group": "1_run@1" },
        { "command": "tomcatAutoDeploy.restart",     "when": "view == tomcatServerView && viewItem == instanceRunning",  "group": "1_run@2" },
        { "command": "tomcatAutoDeploy.forceStop",   "when": "view == tomcatServerView && viewItem == instanceStarting", "group": "1_run@2" },
        { "command": "tomcatAutoDeploy.forceStop",   "when": "view == tomcatServerView && viewItem == instanceRunning",  "group": "1_run@3" },
        { "command": "tomcatAutoDeploy.openBrowser", "when": "view == tomcatServerView && viewItem == instanceRunning",  "group": "2_view@1" },
        { "command": "tomcatAutoDeploy.showOutput",  "when": "view == tomcatServerView && viewItem =~ /^instance/",       "group": "2_view@2" },
        { "command": "tomcatAutoDeploy.showLocalhostLog", "when": "view == tomcatServerView && viewItem =~ /^instance/",  "group": "2_view@3" },
        { "command": "tomcatAutoDeploy.openServerXml",  "when": "view == tomcatServerView && viewItem =~ /^instance/",    "group": "3_conf@1" },
        { "command": "tomcatAutoDeploy.openContextXml", "when": "view == tomcatServerView && viewItem =~ /^instance/",    "group": "3_conf@2" },
        { "command": "tomcatAutoDeploy.removeInstance", "when": "view == tomcatServerView && viewItem =~ /^instance/",     "group": "9_danger@1" },

        { "command": "tomcatAutoDeploy.deleteOrphanFolder", "when": "view == tomcatServerView && viewItem == orphanInstanceFolder", "group": "inline@1" },
        { "command": "tomcatAutoDeploy.deleteOrphanFolder", "when": "view == tomcatServerView && viewItem == orphanInstanceFolder", "group": "9_danger@1" }
      ]
    },
    "configuration": {
      "title": "Tomcat Auto Deploy",
      "properties": {
        "tomcatAutoDeploy.javaHome": {
          "order": 1,
          "type": "string",
          "default": "",
          "description": "%config.javaHome.description%"
        },
        "tomcatAutoDeploy.catalinaHome": {
          "order": 2,
          "type": "string",
          "default": "",
          "description": "%config.catalinaHome.description%"
        },
        "tomcatAutoDeploy.instanceName": {
          "order": 3,
          "type": "string",
          "default": "default",
          "description": "%config.instanceName.description%"
        },
        "tomcatAutoDeploy.servers": {
          "order": 4,
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "required": ["name", "port"],
            "properties": {
              "name":         { "type": "string", "description": "%config.servers.name%" },
              "port":         { "type": "number", "description": "%config.servers.port%" },
              "debugPort":    { "type": "number", "description": "%config.servers.debugPort%" },
              "redirectPort": { "type": "number", "description": "%config.servers.redirectPort%" },
              "javaHome":     { "type": "string", "description": "%config.servers.javaHome%" },
              "catalinaHome": { "type": "string", "description": "%config.servers.catalinaHome%" },
              "javaOpts":     { "type": "string", "description": "%config.servers.javaOpts%" }
            }
          },
          "markdownDescription": "%config.servers.markdownDescription%"
        },
        "tomcatAutoDeploy.javaSourceRoot": {
          "order": 10,
          "type": "string",
          "default": "src/main/java",
          "description": "%config.javaSourceRoot.description%"
        },
        "tomcatAutoDeploy.webContentRoot": {
          "order": 11,
          "type": "string",
          "default": "src/main/webapp",
          "description": "%config.webContentRoot.description%"
        },
        "tomcatAutoDeploy.resourceRoot": {
          "order": 12,
          "type": "string",
          "default": "src/main/resources",
          "description": "%config.resourceRoot.description%"
        },
        "tomcatAutoDeploy.contextPath": {
          "order": 13,
          "type": "string",
          "default": "/",
          "description": "%config.contextPath.description%"
        },
        "tomcatAutoDeploy.manualPortConfig": {
          "order": 20,
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.manualPortConfig.markdownDescription%"
        },
        "tomcatAutoDeploy.port": {
          "order": 21,
          "type": "number",
          "default": 8080,
          "markdownDescription": "%config.port.markdownDescription%"
        },
        "tomcatAutoDeploy.debugPort": {
          "order": 22,
          "type": "number",
          "default": 5005,
          "markdownDescription": "%config.debugPort.markdownDescription%"
        },
        "tomcatAutoDeploy.redirectPort": {
          "order": 23,
          "type": "number",
          "default": 8443,
          "markdownDescription": "%config.redirectPort.markdownDescription%"
        },
        "tomcatAutoDeploy.classpath": {
          "order": 30,
          "type": "array",
          "default": [],
          "description": "%config.classpath.description%"
        },
        "tomcatAutoDeploy.javaOpts": {
          "order": 31,
          "type": "string",
          "default": "-Dfile.encoding=UTF-8",
          "editPresentation": "multilineText",
          "description": "%config.javaOpts.description%"
        }
      }
    }
  },
  "scripts": {
    "test": "node --test",
    "vscode:prepublish": "node -e \"require('fs').writeFileSync('build-info.json', JSON.stringify({ buildTime: new Date().toISOString() }))\""
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "^18.0.0"
  }
}
